+// OpenMV: register explicitly instead of from a static initializer, which
+// does not run on all ports. The backend is constructed in static storage so
+// no destructor is registered.
+executorch::runtime::Error register_ethos_u_backend() {
+  alignas(EthosUBackend) static uint8_t backend_storage[sizeof(EthosUBackend)];
+  static Backend backend_id{
+      "EthosUBackend", new (backend_storage) EthosUBackend()};
+  return register_backend(backend_id);
+}
 
